<?xml version="1.0" encoding="utf-8"?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Remote Game Hub"
           Manufacturer="$(Manufacturer)"
           Version="$(Version)"
           UpgradeCode="91DDC640-BBAE-4574-9FC1-A8389087E1EE"
           Scope="perUserOrMachine"
           Compressed="yes">

    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Remote Game Hub is already installed." />

    <Property Id="WINDOWSBUILDNUMBER">
      <RegistrySearch Id="WindowsBuildSearch"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber"
                      Type="raw"
                      Bitness="always64" />
    </Property>

    <Launch Condition="VersionNT64 AND WINDOWSBUILDNUMBER &gt;= 22000"
            Message="Remote Game Hub needs 64-bit Windows 11 or newer. This machine does not meet that, and nothing has been installed." />

    <Icon Id="AppIcon.ico" SourceFile="$(Icon)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/andrey-lysikov/remote-gamehub" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Property Id="ApplicationFolderName" Value="Remote-Gamehub" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="APPLICATIONFOLDER" Name="Remote-Gamehub" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="CONFIGFOLDER" Name="Remote-Gamehub" />
    </StandardDirectory>

    <SetProperty Id="WixPerUserFolder"
                 Value="[LocalAppDataFolder]Remote-Gamehub"
                 After="WixSetDefaultPerUserFolder"
                 Sequence="both" />

    <SetProperty Id="WixPerMachineFolder"
                 Value="[ProgramFiles64Folder]Remote-Gamehub"
                 After="WixSetDefaultPerMachineFolder"
                 Sequence="both" />

    <Property Id="PERMACHINECOPY" Secure="yes">
      <DirectorySearch Id="PerMachineFolderSearch" Path="[ProgramFiles64Folder]Remote-Gamehub">
        <FileSearch Id="PerMachineExeSearch" Name="Remote-Gamehub.exe" />
      </DirectorySearch>
    </Property>

    <Property Id="PERUSERCOPY" Secure="yes">
      <DirectorySearch Id="PerUserFolderSearch" Path="[LocalAppDataFolder]Remote-Gamehub">
        <FileSearch Id="PerUserExeSearch" Name="Remote-Gamehub.exe" />
      </DirectorySearch>
    </Property>

    <Property Id="SERVICEIMAGEPATH">
      <RegistrySearch Id="ServiceImageSearch" Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\RemoteGameHub" Name="ImagePath"
                      Type="raw" Bitness="always64" />
    </Property>

    <Property Id="VDDSETTING">
      <RegistrySearch Id="VirtualDisplaySettingSearch" Root="HKCU" Key="Software\Remote-Gamehub"
                      Name="VirtualDisplaySetting" Type="raw" />
    </Property>

    <SetProperty Action="SetUpdateMode" Id="UPDATEMODE" Value="1" After="AppSearch" Sequence="both"
                 Condition="NOT Installed AND (WIX_UPGRADE_DETECTED OR PERMACHINECOPY OR PERUSERCOPY OR SERVICEIMAGEPATH ~&gt;&lt; LocalAppDataFolder)" />

    <SetProperty Action="SetServiceIsMine" Id="SERVICEISMINE" Value="1" After="CostFinalize" Sequence="both"
                 Condition="SERVICEIMAGEPATH AND ((INSTALLEDFOLDER AND SERVICEIMAGEPATH ~&gt;&lt; INSTALLEDFOLDER) OR (APPLICATIONFOLDER AND SERVICEIMAGEPATH ~&gt;&lt; APPLICATIONFOLDER))" />

    <SetProperty Action="SetOtherUserCopy" Id="OTHERUSERCOPY" Value="1" After="SetUpdateMode" Sequence="both"
                 Condition="NOT Installed AND NOT UPDATEMODE AND SERVICEIMAGEPATH AND NOT (SERVICEIMAGEPATH ~&gt;&lt; ProgramFiles64Folder) AND NOT (SERVICEIMAGEPATH ~&gt;&lt; LocalAppDataFolder)" />

    <SetProperty Action="SetPerMachineUpgrade" Id="WixAppFolder" Value="WixPerMachineFolder"
                 After="SetOtherUserCopy" Sequence="both"
                 Condition="PERMACHINECOPY" />

    <SetProperty Action="SetPerUserUpgrade" Id="WixAppFolder" Value="WixPerUserFolder"
                 After="SetAllUsersForUpgrade" Sequence="both"
                 Condition="(UPDATEMODE OR OTHERUSERCOPY) AND NOT PERMACHINECOPY" />

    <SetProperty Action="SetAllUsersForUpgrade" Id="ALLUSERS" Value="1"
                 After="SetPerMachineUpgrade" Sequence="both"
                 Condition="PERMACHINECOPY" />

    <SetProperty Action="ClearAllUsersForUpgrade" Id="ALLUSERS" Value="{}"
                 After="SetPerUserUpgrade" Sequence="both"
                 Condition="(UPDATEMODE OR OTHERUSERCOPY) AND NOT PERMACHINECOPY" />

    <SetProperty Action="ClearAllUsersForFirstInstall" Id="ALLUSERS" Value="{}"
                 After="ClearAllUsersForUpgrade" Sequence="both"
                 Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND ALLUSERS=2" />

    <Property Id="INSTALLEDFOLDER" Secure="yes">
      <ComponentSearch Id="InstalledServerSearch"
                       Guid="F7D96560-E799-4DE3-ADDD-C7085743FF44" Type="directory" />
    </Property>

    <SetProperty Action="SetUpgradeFolder" Id="APPLICATIONFOLDER" Value="[INSTALLEDFOLDER]"
                 After="ClearAllUsersForFirstInstall" Sequence="both"
                 Condition="WIX_UPGRADE_DETECTED AND INSTALLEDFOLDER" />

    <?define ShortcutName = "Remote Game Hub" ?>
    <?define ShortcutNote = "Game and desktop streaming to Moonlight clients" ?>

    <ComponentGroup Id="AppFiles" Directory="APPLICATIONFOLDER">
      <Component Id="MainExe" Guid="F7D96560-E799-4DE3-ADDD-C7085743FF44">
        <File Id="RemoteGameHubExe" Source="$(Exe)" Name="Remote-Gamehub.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="StartMenuShortcutFiles" Directory="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="7751937F-1686-474E-BBB6-701852521CDF">
        <Shortcut Id="StartMenuShortcutEntry"
                  Name="$(ShortcutName)"
                  Description="$(ShortcutNote)"
                  Target="[APPLICATIONFOLDER]Remote-Gamehub.exe"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="AppIcon.ico" />

        <RegistryValue Root="HKCU"
                       Key="Software\Remote-Gamehub"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutFiles" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="B5077057-1950-40B9-A649-FCFFD37BE524">
        <Shortcut Id="DesktopShortcutEntry"
                  Name="$(ShortcutName)"
                  Description="$(ShortcutNote)"
                  Target="[APPLICATIONFOLDER]Remote-Gamehub.exe"
                  WorkingDirectory="APPLICATIONFOLDER"
                  Icon="AppIcon.ico" />

        <RegistryValue Root="HKCU"
                       Key="Software\Remote-Gamehub"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="VirtualDisplayConfigFiles" Directory="CONFIGFOLDER">
      <Component Id="VirtualDisplayConfig" Guid="7FC65322-E599-43EA-A41B-55472499DA5C">
        <IniFile Id="SetVirtualDisplay" Action="addLine" Directory="CONFIGFOLDER"
                 Name="Remote-Gamehub.conf" Section="General" Key="VirtualDisplay" Value="true" />

        <RegistryValue Root="HKCU"
                       Key="Software\Remote-Gamehub"
                       Name="VirtualDisplaySetting"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Property Id="INSTALLSTARTMENUSHORTCUT" Value="1" />
    <Property Id="INSTALLDESKTOPSHORTCUT" Value="1" />

    <Property Id="INSTALLVIGEM" Value="1" />

    <Property Id="INSTALLVDD" Value="0" />

    <Feature Id="Main"
             Title="Remote Game Hub"
             Description="The server itself."
             Level="1"
             AllowAbsent="no"
             ConfigurableDirectory="APPLICATIONFOLDER">
      <ComponentGroupRef Id="AppFiles" />

      <Feature Id="StartMenu" Title="Start menu shortcut"
               Description="A shortcut in the Start menu." Level="1">
        <ComponentGroupRef Id="StartMenuShortcutFiles" />
        <Level Value="0" Condition="NOT UPDATEMODE AND INSTALLSTARTMENUSHORTCUT &lt;&gt; 1" />
      </Feature>

      <Feature Id="Desktop" Title="Desktop shortcut"
               Description="A shortcut on the desktop." Level="1">
        <ComponentGroupRef Id="DesktopShortcutFiles" />
        <Level Value="0" Condition="NOT UPDATEMODE AND INSTALLDESKTOPSHORTCUT &lt;&gt; 1" />
      </Feature>

      <Feature Id="VirtualDisplaySetting" Title="Virtual display driver"
               Description="Turns on [General] VirtualDisplay in the configuration file." Level="1">
        <ComponentGroupRef Id="VirtualDisplayConfigFiles" />
        <Level Value="0" Condition="(NOT UPDATEMODE AND INSTALLVDD &lt;&gt; 1) OR (UPDATEMODE AND NOT VDDSETTING)" />
      </Feature>

    </Feature>

    <CustomAction Id="RemoveService"
                  Directory="APPLICATIONFOLDER"
                  ExeCommand="&quot;[#RemoteGameHubExe]&quot; uninstall-service"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <util:CloseApplication Id="CloseRunningServer"
                           Target="Remote-Gamehub.exe"
                           CloseMessage="yes"
                           ElevatedCloseMessage="yes"
                           TerminateProcess="0"
                           RebootPrompt="no"
                           Timeout="10" />

    <CustomAction Id="RemoveAutostartTask"
                  Directory="APPLICATIONFOLDER"
                  ExeCommand="[System64Folder]schtasks.exe /delete /tn &quot;Remote Game Hub&quot; /f"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <SetProperty Action="SetStopServer" Id="WixQuietExecCmdLine" Sequence="execute" Before="StopServer"
                 Condition="UPDATEMODE AND NOT REMOVE~=&quot;ALL&quot;"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Stop-Service -Name RemoteGameHub -ErrorAction SilentlyContinue; Wait-Process -Name Remote-Gamehub -Timeout 15 -ErrorAction SilentlyContinue; exit 0&quot;" />
    <CustomAction Id="StopServer" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64"
                  Execute="immediate" Return="ignore" />

    <SetProperty Id="StartServer" Sequence="execute" Before="StartServer"
                 Condition="UPDATEMODE AND NOT REMOVE~=&quot;ALL&quot;"
                 Value="&quot;[#RemoteGameHubExe]&quot; install-service" />
    <CustomAction Id="StartServer" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopServer" Before="RemoveExistingProducts"
              Condition="UPDATEMODE AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="StartServer" After="InstallFiles"
              Condition="UPDATEMODE AND NOT REMOVE~=&quot;ALL&quot;" />

      <Custom Action="RemoveService" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND SERVICEISMINE" />
      <Custom Action="RemoveAutostartTask" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <SetProperty Id="ELEVATIONREQUESTED" Value="1" Sequence="ui" Before="RelaunchElevated"
                 Condition="UPDATEMODE AND NOT ELEVATED AND UILevel = 5" />
    <SetProperty Id="WixQuietExecCmdLine" Sequence="ui" Before="RelaunchElevated"
                 Condition="UPDATEMODE AND NOT ELEVATED AND UILevel = 5"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;Start-Process -FilePath '[System64Folder]msiexec.exe' -Verb RunAs -ArgumentList '/i \&quot;[OriginalDatabase]\&quot; ELEVATED=1' -ErrorAction SilentlyContinue; exit (0 + $?)&quot;" />

    <CustomAction Id="RelaunchElevated" DllEntry="WixQuietExec" BinaryRef="Wix4UtilCA_X64"
                  Execute="immediate" Return="check" />

    <SetProperty Id="UPDSTARTMENU" Value="1" Sequence="ui" After="MigrateFeatureStates"
                 Condition="UPDATEMODE AND &amp;StartMenu = 3" />
    <SetProperty Id="UPDDESKTOP" Value="1" Sequence="ui" After="MigrateFeatureStates"
                 Condition="UPDATEMODE AND &amp;Desktop = 3" />

    <SetProperty Action="HideWelcomeForUpdate" Id="Installed" Value="1" Sequence="ui"
                 Before="AdvancedWelcomeEulaDlg" Condition="UPDATEMODE AND NOT Installed AND NOT ELEVATIONREQUESTED" />
    <SetProperty Action="HideMaintenanceForUpdate" Id="PATCH" Value="1" Sequence="ui"
                 After="AdvancedWelcomeEulaDlg" Condition="UPDATEMODE AND NOT ELEVATIONREQUESTED" />
    <SetProperty Action="ClearInstalledForUpdate" Id="Installed" Value="{}" Sequence="ui"
                 After="MaintenanceWelcomeDlg" Condition="UPDATEMODE AND NOT ELEVATIONREQUESTED" />
    <SetProperty Action="ClearPatchForUpdate" Id="PATCH" Value="{}" Sequence="ui"
                 After="ClearInstalledForUpdate" Condition="UPDATEMODE AND NOT ELEVATIONREQUESTED" />

    <InstallUISequence>
      <Custom Action="RelaunchElevated" After="MigrateFeatureStates"
              Condition="UPDATEMODE AND NOT ELEVATED AND UILevel = 5" />
      <Show Dialog="AdminNeededDlg" After="RelaunchElevated" Condition="ELEVATIONREQUESTED" />
      <Show Dialog="UpdateDlg" After="ClearPatchForUpdate"
            Condition="UPDATEMODE AND NOT Installed AND NOT ELEVATIONREQUESTED" />

      <Show Dialog="override UserExit" OnExit="cancel" Condition="NOT ELEVATIONREQUESTED" />
      <Show Dialog="override FatalError" OnExit="error" Condition="NOT ELEVATIONREQUESTED" />
    </InstallUISequence>

    <ui:WixUI Id="WixUI_Advanced" />
    <WixVariable Id="WixUILicenseRtf" Value="$(License)" />

    <Property Id="LAUNCHAFTERINSTALL" Value="1" />

    <CustomAction Id="SetAppTarget" Property="WixShellExecTarget" Value="[#RemoteGameHubExe]" />
    <CustomAction Id="LaunchApplication" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" />

    <CustomAction Id="SetViGEmTarget" Property="WixShellExecTarget"
                  Value="https://github.com/nefarius/ViGEmBus/releases/latest" />
    <CustomAction Id="OpenViGEmPage" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" />

    <CustomAction Id="SetVddTarget" Property="WixShellExecTarget"
                  Value="https://github.com/VirtualDrivers/Virtual-Display-Driver/releases" />
    <CustomAction Id="OpenVddPage" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_X64" Impersonate="yes" />

    <UI>
      <Publish Dialog="InstallScopeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Condition="WixAppFolder = &quot;WixPerUserFolder&quot;" Order="10" />

      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ShortcutsDlg" Order="10" />
      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="RemoveElevatedDlg"
               Condition="SERVICEISMINE AND NOT ELEVATED" Order="10" />

      <Publish Dialog="AdvancedWelcomeEulaDlg" Control="Advanced" Event="NewDialog"
               Value="ShortcutsDlg" Condition="WIX_UPGRADE_DETECTED OR OTHERUSERCOPY" Order="20" />

      <Publish Dialog="ShortcutsDlg" Control="Back" Event="NewDialog"
               Value="AdvancedWelcomeEulaDlg" Condition="WIX_UPGRADE_DETECTED OR OTHERUSERCOPY" Order="10" />
      <Publish Dialog="ShortcutsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ShortcutsDlg"
               Condition="NOT Installed" Order="10" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetAppTarget"
               Condition="LAUNCHAFTERINSTALL = 1 AND NOT Installed AND NOT UPDATEMODE" Order="1" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="LAUNCHAFTERINSTALL = 1 AND NOT Installed AND NOT UPDATEMODE" Order="2" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetViGEmTarget"
               Condition="INSTALLVIGEM = 1 AND NOT Installed AND NOT UPDATEMODE" Order="3" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenViGEmPage"
               Condition="INSTALLVIGEM = 1 AND NOT Installed AND NOT UPDATEMODE" Order="4" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SetVddTarget"
               Condition="INSTALLVDD = 1 AND NOT Installed AND NOT UPDATEMODE" Order="5" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="OpenVddPage"
               Condition="INSTALLVDD = 1 AND NOT Installed AND NOT UPDATEMODE" Order="6" />
    </UI>
  </Package>
</Wix>
