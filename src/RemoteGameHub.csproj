<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Remote-Gamehub</AssemblyName>
    <RootNamespace>RemoteGameHub</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

  </PropertyGroup>

  <PropertyGroup>
    <Product>Remote Game Hub</Product>
    <Company>lysnet.ru</Company>
    <Authors>Andrey.Lysikov and Claude</Authors>
    <Copyright>© Andrey Lysikov, Apache 2.0 licence.</Copyright>
    <Description>Desktop and game streaming to Moonlight clients, encoded on the graphics card.</Description>
    <Version>2.1</Version>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IconFile>$(MSBuildThisFileDirectory)..\pictures\RemoteGameHub.ico</IconFile>
    <ApplicationIcon>$(IconFile)</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RollForward>LatestMajor</RollForward>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(IconFile)" LogicalName="RemoteGameHub.Icons.%(Filename)%(Extension)" />

    <EmbeddedResource Include="Web\page.html" LogicalName="RemoteGameHub.Web.page.html" />
    <EmbeddedResource Include="Web\page.css" LogicalName="RemoteGameHub.Web.page.css" />
    <EmbeddedResource Include="Web\page.js" LogicalName="RemoteGameHub.Web.page.js" />

    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\pictures\desktop-cover.png" LogicalName="RemoteGameHub.Art.desktop-cover.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteGameHub.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

</Project>
